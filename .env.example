# ATLAS Configuration Example (No real secrets!)
# Copy to .env and adjust as needed.

# Database: PostgreSQL in Docker/production, SQLite for zero-Docker local runs
# ATLAS_DATABASE_URL=postgresql+psycopg://atlas:atlas_dev_password@localhost:5432/atlas
ATLAS_DATABASE_URL=sqlite:///./var/atlas.db

# Object storage directory (local adapter)
ATLAS_OBJECT_STORE_DIR=./var/objects
ATLAS_SANDBOX_STATE_FILE=./var/sandbox_publisher.json
ATLAS_URL_SIGNING_KEY=change-this-in-production

# LLM Model: "template" (deterministic, zero-API-key) or a LangChain model id e.g. "openai:gpt-4.1-mini"
ATLAS_LLM_MODEL=template
# OPENAI_API_KEY=

# Temporal (optional locally; leave empty to use the DB-leased local worker engine)
ATLAS_TEMPORAL_ADDRESS=
ATLAS_TEMPORAL_TASK_QUEUE=atlas-missions

# Langfuse Telemetry (optional; leave empty to disable external export)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# External Connector Secret References (never commit values)
FACEBOOK_PAGE_TOKEN=
GOOGLE_ADS_CREDENTIALS=
MEDIA_PROVIDER_API_KEY=

# Frontend API URL
NEXT_PUBLIC_ATLAS_API_URL=http://127.0.0.1:8000
